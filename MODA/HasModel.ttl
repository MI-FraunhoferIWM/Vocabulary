@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/HasModel> a owl:ObjectProperty ;
    rdfs:label "has model" ;
    dcterms:description "Links a simulation to one physics-based model in its chain." ;
    dcterms:identifier "HasModel" ;
    rdfs:comment "Links a simulation to one physics-based model in its chain." .

