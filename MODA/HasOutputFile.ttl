@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/HasOutputFile> a owl:ObjectProperty ;
    rdfs:label "has output file" ;
    dcterms:description "Links a post-processing step to a file attachment containing output data." ;
    dcterms:identifier "HasOutputFile" ;
    rdfs:comment "Links a post-processing step to a file attachment containing output data." .

