@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/PhysicsBasedModel> a owl:Class ;
    rdfs:label "Physics-Based Model" ;
    dcterms:description "A solvable set of one physics equation and one or more materials relations (CWA 17284:2018 §3.5). Classified by the entity type whose behaviour it describes." ;
    dcterms:identifier "PhysicsBasedModel" ;
    rdfs:comment "A solvable set of one physics equation and one or more materials relations (CWA 17284:2018 §3.5). Classified by the entity type whose behaviour it describes." .

