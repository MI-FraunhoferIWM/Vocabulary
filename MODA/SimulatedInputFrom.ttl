@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/SimulatedInputFrom> a owl:ObjectProperty ;
    rdfs:label "simulated input from" ;
    dcterms:description "Links a physics equation's simulated input (§2.5) to the post-processing step of the preceding model that produced it." ;
    dcterms:identifier "SimulatedInputFrom" ;
    rdfs:comment "Links a physics equation's simulated input (§2.5) to the post-processing step of the preceding model that produced it." .

