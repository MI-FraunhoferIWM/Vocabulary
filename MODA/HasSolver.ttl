@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/HasSolver> a owl:ObjectProperty ;
    rdfs:label "has solver" ;
    dcterms:description "Links a physics-based model to the numerical solver used to solve it." ;
    dcterms:identifier "HasSolver" ;
    rdfs:comment "Links a physics-based model to the numerical solver used to solve it." .

