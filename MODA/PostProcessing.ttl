@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/PostProcessing> a owl:Class ;
    rdfs:label "Post-Processing" ;
    dcterms:description "Operations on the raw output of a solver that do not alter the physical system state (CWA §3.12). Produces the processed output (light green circle in MODA workflow)." ;
    dcterms:identifier "PostProcessing" ;
    rdfs:comment "Operations on the raw output of a solver that do not alter the physical system state (CWA §3.12). Produces the processed output (light green circle in MODA workflow)." .

