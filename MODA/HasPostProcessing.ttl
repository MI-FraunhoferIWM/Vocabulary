@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/HasPostProcessing> a owl:ObjectProperty ;
    rdfs:label "has post-processing" ;
    dcterms:description "Links a physics-based model to its post-processing step." ;
    dcterms:identifier "HasPostProcessing" ;
    rdfs:comment "Links a physics-based model to its post-processing step." .

