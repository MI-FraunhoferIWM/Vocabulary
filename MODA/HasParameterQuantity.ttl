@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/HasParameterQuantity> a owl:DatatypeProperty ;
    rdfs:label "has parameter quantity" ;
    dcterms:description "Physics quantities not solved for (parameters). Each requires a materials relation to provide a value (CWA Table 5, §2.3)." ;
    dcterms:identifier "HasParameterQuantity" ;
    rdfs:comment "Physics quantities not solved for (parameters). Each requires a materials relation to provide a value (CWA Table 5, §2.3)." .

