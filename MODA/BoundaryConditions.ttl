<https://w3id.org/dsms/moda/BoundaryConditions> a owl:DatatypeProperty ;
    rdfs:label "boundary conditions" ;
    dcterms:description "Computational translation of physical boundary conditions, e.g. periodic BC to simulate infinite domain (CWA Table 6, §3.5)." ;
