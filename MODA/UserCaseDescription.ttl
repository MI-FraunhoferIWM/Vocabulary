@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/UserCaseDescription> a owl:DatatypeProperty ;
    rdfs:label "user case description" ;
    dcterms:description "One-sentence description of the user case. No modelling information allowed (CWA Table 2, Row 1)." ;
    dcterms:identifier "UserCaseDescription" ;
    rdfs:comment "One-sentence description of the user case. No modelling information allowed (CWA Table 2, Row 1)." .

