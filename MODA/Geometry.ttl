@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/Geometry> a owl:DatatypeProperty ;
    rdfs:label "geometry" ;
    dcterms:description "Geometry of the physical system: size, form, drawing. Not the computational domain (CWA Table 4, §1.3)." ;
