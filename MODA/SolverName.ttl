@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/SolverName> a owl:DatatypeProperty ;
    rdfs:label "solver name" ;
    dcterms:description "Name of the solver technique, e.g. 'Verlet integrator', 'multi-grid' (CWA Table 6, §3.1)." ;
    dcterms:identifier "SolverName" ;
    rdfs:comment "Name of the solver technique, e.g. 'Verlet integrator', 'multi-grid' (CWA Table 6, §3.1)." .

