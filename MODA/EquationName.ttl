@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/dsms/moda/EquationName> a owl:DatatypeProperty ;
    rdfs:label "equation name" ;
    dcterms:description "Standard name of the physics equation, e.g. 'Newton's equations of motion' (CWA Table 5, §2.3)." ;
    dcterms:identifier "EquationName" ;
    rdfs:comment "Standard name of the physics equation, e.g. 'Newton's equations of motion' (CWA Table 5, §2.3)." .

