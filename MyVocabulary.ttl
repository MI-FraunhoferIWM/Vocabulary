@prefix ns1: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://vocabulary.materials-data.space/myvocabulary> a owl:Ontology .

<https://w3id.org/dsms/myvocabulary/SemanticManager> a owl:Class ;
    rdfs:label "Semantic Manager" ;
    ns1:description "Software component for centrally registering, managing, searching, publishing, and extending ontologies and controlled vocabularies to support consistent semantic reuse across data systems." ;
    ns1:identifier "SemanticManager" .

