@prefix ns1: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://vocabulary.materials-data.space/moda> a owl:Ontology .

<https://w3id.org/dsms/moda/AdditionalSolverParameters> a owl:DatatypeProperty ;
    rdfs:label "additional solver parameters" ;
    ns1:description "Internal numerical solver details: tolerances, convergence criteria, integrator options, under-relaxation parameters (CWA Table 6, §3.6)." ;
    ns1:identifier "AdditionalSolverParameters" ;
    rdfs:comment "Internal numerical solver details: tolerances, convergence criteria, integrator options, under-relaxation parameters (CWA Table 6, §3.6)." .

<https://w3id.org/dsms/moda/AddressesUserCase> a owl:ObjectProperty ;
    rdfs:label "addresses user case" ;
    ns1:description "Indicates which user case aspect this model addresses in the simulation chain." ;
    ns1:identifier "AddressesUserCase" ;
    rdfs:comment "Indicates which user case aspect this model addresses in the simulation chain." .

<https://w3id.org/dsms/moda/AspectDescription> a owl:DatatypeProperty ;
    rdfs:label "aspect description" ;
    ns1:description "Textual description of the user case aspect simulated by this model. No modelling information (CWA Table 4, §1.1)." ;
    ns1:identifier "AspectDescription" ;
    rdfs:comment "Textual description of the user case aspect simulated by this model. No modelling information (CWA Table 4, §1.1)." .

<https://w3id.org/dsms/moda/AtomisticModel> a owl:Class ;
    rdfs:label "Atomistic Model" ;
    ns1:description "Physics-based model describing the behaviour of atom entities (CWA §3.7.2)." ;
    ns1:identifier "AtomisticModel" ;
    rdfs:comment "Physics-based model describing the behaviour of atom entities (CWA §3.7.2)." .

<https://w3id.org/dsms/moda/BoundaryConditions> a owl:DatatypeProperty ;
    rdfs:label "boundary conditions" ;
    ns1:description "Computational translation of physical boundary conditions, e.g. periodic BC to simulate infinite domain (CWA Table 6, §3.5)." ;
    ns1:identifier "BoundaryConditions" ;
    rdfs:comment "Computational translation of physical boundary conditions, e.g. periodic BC to simulate infinite domain (CWA Table 6, §3.5)." .

<https://w3id.org/dsms/moda/CGMDSolver> a owl:Class ;
    rdfs:label "Coarse-Grained MD Solver" ;
    ns1:identifier "CGMDSolver" .

<https://w3id.org/dsms/moda/ChainPosition> a owl:DatatypeProperty ;
    rdfs:label "chain position" ;
    ns1:description "Ordering index of this model in the simulation chain (1 = first model)." ;
    ns1:identifier "ChainPosition" ;
    rdfs:comment "Ordering index of this model in the simulation chain (1 = first model)." .

<https://w3id.org/dsms/moda/ComplementsPhysicsEquation> a owl:ObjectProperty ;
    rdfs:label "complements physics equation" ;
    ns1:description "Indicates which physics equation this materials relation provides parameter values for." ;
    ns1:identifier "ComplementsPhysicsEquation" ;
    rdfs:comment "Indicates which physics equation this materials relation provides parameter values for." .

<https://w3id.org/dsms/moda/ComputationalDomain> a owl:DatatypeProperty ;
    rdfs:label "computational domain" ;
    ns1:description "How the physics equation, materials relation, and material are represented computationally (CWA Table 6, §3.4)." ;
    ns1:identifier "ComputationalDomain" ;
    rdfs:comment "How the physics equation, materials relation, and material are represented computationally (CWA Table 6, §3.4)." .

<https://w3id.org/dsms/moda/ComputationalRepresentationOfMaterial> a owl:DatatypeProperty ;
    rdfs:label "computational representation of material" ;
    ns1:description "Computational representation of the material, e.g. atom positions, crystal lattice, mesh, particle distribution (CWA Table 6, §3.4)." ;
    ns1:identifier "ComputationalRepresentationOfMaterial" .

<https://w3id.org/dsms/moda/ComputationalRepresentationOfMaterialsRelation> a owl:DatatypeProperty ;
    rdfs:label "computational representation of materials relation" ;
    ns1:description "Computational representation of the materials relation (CWA Table 6, §3.4)." ;
    ns1:identifier "ComputationalRepresentationOfMaterialsRelation" .

<https://w3id.org/dsms/moda/ComputationalRepresentationOfPhysicsEquation> a owl:DatatypeProperty ;
    rdfs:label "computational representation of physics equation" ;
    ns1:description "Computational representation of the physics equation. Model information (physics) shall not be repeated here (CWA Table 6, §3.4)." ;
    ns1:identifier "ComputationalRepresentationOfPhysicsEquation" .

<https://w3id.org/dsms/moda/ConstitutiveEquation> a owl:Class ;
    rdfs:label "Constitutive Equation" ;
    ns1:description "Materials relation used in continuum models (CWA §3.4 example)." ;
    ns1:identifier "ConstitutiveEquation" ;
    rdfs:comment "Materials relation used in continuum models (CWA §3.4 example)." .

<https://w3id.org/dsms/moda/ContinuumModel> a owl:Class ;
    rdfs:label "Continuum Model" ;
    ns1:description "Physics-based model describing the behaviour of continuum volume entities (CWA §3.7.4)." ;
    ns1:identifier "ContinuumModel" ;
    rdfs:comment "Physics-based model describing the behaviour of continuum volume entities (CWA §3.7.4)." .

<https://w3id.org/dsms/moda/CouplingType> a owl:DatatypeProperty ;
    rdfs:label "coupling type" ;
    ns1:description "How this model connects to the previous one: standalone | linked | iterative_coupling | tight_coupling (CWA §3.13-3.16)." ;
    ns1:identifier "CouplingType" ;
    rdfs:comment "How this model connects to the previous one: standalone | linked | iterative_coupling | tight_coupling (CWA §3.13-3.16)." .

<https://w3id.org/dsms/moda/DFTSolver> a owl:Class ;
    rdfs:label "DFT Solver" ;
    ns1:identifier "DFTSolver" .

<https://w3id.org/dsms/moda/ElectronicModel> a owl:Class ;
    rdfs:label "Electronic Model" ;
    ns1:description "Physics-based model describing the behaviour of electron entities (CWA §3.7.1)." ;
    ns1:identifier "ElectronicModel" ;
    rdfs:comment "Physics-based model describing the behaviour of electron entities (CWA §3.7.1)." .

<https://w3id.org/dsms/moda/EntityType> a owl:DatatypeProperty ;
    rdfs:label "entity type" ;
    ns1:description "Simulated entity type: electron entity | atom entity | mesoscopic entity | continuum volume entity (CWA Table 5, §2.2)." ;
    ns1:identifier "EntityType" ;
    rdfs:comment "Simulated entity type: electron entity | atom entity | mesoscopic entity | continuum volume entity (CWA Table 5, §2.2)." .

<https://w3id.org/dsms/moda/EquationName> a owl:DatatypeProperty ;
    rdfs:label "equation name" ;
    ns1:description "Standard name of the physics equation, e.g. 'Newton's equations of motion' (CWA Table 5, §2.3)." ;
    ns1:identifier "EquationName" ;
    rdfs:comment "Standard name of the physics equation, e.g. 'Newton's equations of motion' (CWA Table 5, §2.3)." .

<https://w3id.org/dsms/moda/FiniteElementSolver> a owl:Class ;
    rdfs:label "Finite Element Solver" ;
    ns1:identifier "FiniteElementSolver" .

<https://w3id.org/dsms/moda/ForceField> a owl:Class ;
    rdfs:label "Force Field" ;
    ns1:description "Materials relation used in atomistic models (CWA §3.4 example)." ;
    ns1:identifier "ForceField" ;
    rdfs:comment "Materials relation used in atomistic models (CWA §3.4 example)." .

<https://w3id.org/dsms/moda/FunctionalForm> a owl:DatatypeProperty ;
    rdfs:label "functional form" ;
    ns1:description "Mathematical form of the relation or a literature reference." ;
    ns1:identifier "FunctionalForm" ;
    rdfs:comment "Mathematical form of the relation or a literature reference." .

<https://w3id.org/dsms/moda/Geometry> a owl:DatatypeProperty ;
    rdfs:label "geometry" ;
    ns1:description "Geometry of the physical system: size, form, drawing. Not the computational domain (CWA Table 4, §1.3)." ;
    ns1:identifier "Geometry" ;
    rdfs:comment "Geometry of the physical system: size, form, drawing. Not the computational domain (CWA Table 4, §1.3)." .

<https://w3id.org/dsms/moda/Hamiltonian> a owl:Class ;
    rdfs:label "Hamiltonian" ;
    ns1:description "Materials relation used in electronic models (CWA §3.4 example)." ;
    ns1:identifier "Hamiltonian" ;
    rdfs:comment "Materials relation used in electronic models (CWA §3.4 example)." .

<https://w3id.org/dsms/moda/HasChainOfModels> a owl:ObjectProperty ;
    rdfs:label "hasChainOfModels" ;
    ns1:identifier "HasChainOfModels" .

<https://w3id.org/dsms/moda/HasMaterialModel> a owl:Class ;
    rdfs:label "has Material Model" ;
    ns1:identifier "HasMaterialModel" .

<https://w3id.org/dsms/moda/HasMaterialsRelation> a owl:ObjectProperty ;
    rdfs:label "has materials relation" ;
    ns1:description "Links a physics-based model to one of its materials relations." ;
    ns1:identifier "HasMaterialsRelation" ;
    rdfs:comment "Links a physics-based model to one of its materials relations." .

<https://w3id.org/dsms/moda/HasModel> a owl:ObjectProperty ;
    rdfs:label "has model" ;
    ns1:description "Links a simulation to one physics-based model in its chain." ;
    ns1:identifier "HasModel" ;
    rdfs:comment "Links a simulation to one physics-based model in its chain." .

<https://w3id.org/dsms/moda/HasModellingDataWorkflow> a owl:ObjectProperty ;
    rdfs:label "has modelling data workflow" ;
    ns1:identifier "HasModellingDataWorkflow" .

<https://w3id.org/dsms/moda/HasOutputFile> a owl:ObjectProperty ;
    rdfs:label "has output file" ;
    ns1:description "Links a post-processing step to a file attachment containing output data." ;
    ns1:identifier "HasOutputFile" ;
    rdfs:comment "Links a post-processing step to a file attachment containing output data." .

<https://w3id.org/dsms/moda/HasParameterQuantity> a owl:DatatypeProperty ;
    rdfs:label "has parameter quantity" ;
    ns1:description "Physics quantities not solved for (parameters). Each requires a materials relation to provide a value (CWA Table 5, §2.3)." ;
    ns1:identifier "HasParameterQuantity" ;
    rdfs:comment "Physics quantities not solved for (parameters). Each requires a materials relation to provide a value (CWA Table 5, §2.3)." .

