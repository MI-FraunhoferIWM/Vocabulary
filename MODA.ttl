    ns1:identifier "HasPhysicsQuantity" ;
    rdfs:comment "Parameters and variables appearing in this materials relation (CWA Table 5, §2.4)." .

<https://w3id.org/dsms/moda/HasPostProcessing> a owl:ObjectProperty ;
    rdfs:label "has post-processing" ;
