<https://w3id.org/dsms/moda/HasSymbol> a owl:DatatypeProperty ;
    rdfs:label "has symbol" ;
    ns1:identifier "HasSymbol" .

<https://w3id.org/dsms/moda/HasUserCase> a owl:ObjectProperty ;
    rdfs:label "has user case" ;
